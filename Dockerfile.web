FROM python:3.11-slim
WORKDIR /app
COPY requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt
COPY data_upload_app.py ./
ENV PORT=8501
EXPOSE 8501
CMD ["sh", "-c", "streamlit run data_upload_app.py --server.address=0.0.0.0 --server.port=$PORT --server.headless=true --browser.gatherUsageStats=false"]
